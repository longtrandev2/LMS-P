# LMS-P environment — copy to .env and adjust values.
# NOTE: DATABASE_URL / RABBITMQ_URL here use localhost (host-side dev).
# Inside docker-compose, services get internal hostnames (mysql, rabbitmq) — see infra/docker-compose.yml.

DATABASE_URL=mysql+asyncmy://lms:lms@localhost:3306/lms
RABBITMQ_URL=amqp://lms:lms@localhost:5672/
JWT_SECRET=change-me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=100

# docker-compose overrides (infra/docker-compose.yml) — có default, chỉ đổi khi cần
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=lms
MYSQL_USER=lms
MYSQL_PASSWORD=lms
RABBITMQ_USER=lms
RABBITMQ_PASS=lms
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

