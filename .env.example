# LMS-P environment — copy to infra/.env and adjust values.
MYSQL_ROOT_PASSWORD=root
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_DATABASE=lms
MYSQL_USER=lms
MYSQL_PASSWORD=lms
MYSQL_WORKER_USER=lms_worker
MYSQL_WORKER_PASSWORD=change-me-use-a-unique-random-secret
RABBITMQ_USER=lms
RABBITMQ_PASS=lms
JWT_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
STORAGE_DIR=/app/storage
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
WORKER_PREFETCH=2
