# Sao chép file này thành infra/.env rồi thay các giá trị mẫu trước khi chạy.
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=lms
MYSQL_USER=lms
MYSQL_PASSWORD=change-this-database-password

RABBITMQ_USER=lms
RABBITMQ_PASS=change-this-rabbitmq-password

# Thay bằng chuỗi ngẫu nhiên bí mật dài ít nhất 32 ký tự.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
WORKER_PREFETCH=2
